### Library Management API - Borrowing, Returning & Renewals
@baseUrl = http://localhost:8080/api/v1

### Login as Member
# @name loginMember
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "member@library.com",
  "password": "password123"
}

@memberToken = {{loginMember.response.body.accessToken}}

### Login as Librarian
# @name loginLibrarian
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "librarian@library.com",
  "password": "password123"
}

@librarianToken = {{loginLibrarian.response.body.accessToken}}

### 1. Member Borrows a Book (Effective Java)
# @name borrowBook
POST {{baseUrl}}/loans
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "bookId": "b1111111-1111-1111-1111-111111111111"
}

@loanId = {{borrowBook.response.body.id}}

### 2. View My Active Loans
GET {{baseUrl}}/loans/me?status=ACTIVE
Authorization: Bearer {{memberToken}}

### 3. Member Renews the Loan
POST {{baseUrl}}/loans/{{loanId}}/renew
Authorization: Bearer {{memberToken}}

### 4. Librarian Records Book Return
POST {{baseUrl}}/loans/{{loanId}}/return
Authorization: Bearer {{librarianToken}}

### 5. Librarian Search All Active Loans
GET {{baseUrl}}/loans?status=ACTIVE
Authorization: Bearer {{librarianToken}}

### 6. Librarian Query Overdue Loans
GET {{baseUrl}}/loans?overdue=true
Authorization: Bearer {{librarianToken}}
