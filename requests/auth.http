### Library Management API - Authentication & Users
@baseUrl = http://localhost:8080/api/v1

### 1. Register a New Member
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "carol.member@library.com",
  "password": "Password123!",
  "fullName": "Carol Danvers"
}

### 2. Login as Admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@library.com",
  "password": "password123"
}

### Save Admin Token
@adminToken = {{loginAdmin.response.body.accessToken}}

### 3. Login as Librarian
# @name loginLibrarian
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "librarian@library.com",
  "password": "password123"
}

### Save Librarian Token
@librarianToken = {{loginLibrarian.response.body.accessToken}}

### 4. Login as Member (Alice)
# @name loginMember
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "member@library.com",
  "password": "password123"
}

### Save Member Token
@memberToken = {{loginMember.response.body.accessToken}}

### 5. Get My Profile (Member)
GET {{baseUrl}}/users/me
Authorization: Bearer {{memberToken}}

### 6. Admin Update User Role
PATCH {{baseUrl}}/users/33333333-3333-3333-3333-333333333333/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "LIBRARIAN"
}

### 7. Admin Toggle User Active Status
PATCH {{baseUrl}}/users/33333333-3333-3333-3333-333333333333/active
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "active": true
}
